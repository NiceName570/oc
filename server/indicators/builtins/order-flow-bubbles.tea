indicator("Order Flow Bubbles", overlay = true)
// DeepCharts-inspired proportional volume orbs computed from OHLCV candles:
// scaled buy/sell volume orbs, optional nested opposite-color wick absorption
// orbs, and optional custom candle coloring. Every color supports custom
// hue and transparency in Inputs.

volLen = input.int(20, "Volume lookback", minval = 5, maxval = 200)
bubbleMult = input.float(1.2, "Bubble threshold (x avg vol)", minval = 0.5, maxval = 5.0, step = 0.1)
buyOrbColor = input.color(color.new(#7CFF2E, 25), "Buy orb color")
sellOrbColor = input.color(color.new(#FF2020, 25), "Sell orb color")
showAbsorption = input.bool(true, "Show nested absorption orbs")
absorbRatio = input.float(0.30, "Absorption wick ratio", minval = 0.1, maxval = 0.8, step = 0.05)
buyAbsorbColor = input.color(color.new(#7CFF2E, 15), "Buy absorption orb color")
sellAbsorbColor = input.color(color.new(#FF2020, 15), "Sell absorption orb color")
colorCandles = input.bool(false, "Color candles")
bullCandleColor = input.color(#4ADE80, "Bull candle color")
bearCandleColor = input.color(#9333EA, "Bear candle color")

// --- 1. Proportional buy & sell volume orbs ---
volAvg = ta.sma(volume, volLen)
relVol = volAvg > 0 ? volume / volAvg : 0.0
ratio = bubbleMult > 0 ? relVol / bubbleMult : 0.0

barRange = high - low
bodyTop = math.max(open, close)
bodyBottom = math.min(open, close)
upperWick = high - bodyTop
lowerWick = bodyBottom - low
buyPressure = barRange > 0 ? (close - low) / barRange : (close >= open ? 0.65 : 0.35)
isBuyBurst = close > open or (close == open and buyPressure >= 0.5)

bubblePrice = (close + hl2) / 2
bubbleColor = isBuyBurst ? buyOrbColor : sellOrbColor

plot("bubble_xs", ratio >= 1.0 and ratio < 1.3 ? bubblePrice : na, "Orb XS", color = bubbleColor, linewidth = 4, style = plot.style_circles, display = display.pane)
plot("bubble_s", ratio >= 1.3 and ratio < 1.7 ? bubblePrice : na, "Orb S", color = bubbleColor, linewidth = 8, style = plot.style_circles, display = display.pane)
plot("bubble_m", ratio >= 1.7 and ratio < 2.25 ? bubblePrice : na, "Orb M", color = bubbleColor, linewidth = 13, style = plot.style_circles, display = display.pane)
plot("bubble_l", ratio >= 2.25 and ratio < 3.0 ? bubblePrice : na, "Orb L", color = bubbleColor, linewidth = 20, style = plot.style_circles, display = display.pane)
plot("bubble_xl", ratio >= 3.0 ? bubblePrice : na, "Orb XL", color = bubbleColor, linewidth = 28, style = plot.style_circles, display = display.pane)

// --- 2. Nested opposite-color absorption orbs on heavy opposing wicks ---
oppWickRatio = barRange > 0 ? (isBuyBurst ? upperWick / barRange : lowerWick / barRange) : 0.0
hasAbsorption = showAbsorption and ratio >= 1.5 and oppWickRatio >= absorbRatio
absorbColor = isBuyBurst ? sellAbsorbColor : buyAbsorbColor
plot("absorb_s", hasAbsorption and ratio < 2.3 ? bubblePrice : na, "Absorption S", color = absorbColor, linewidth = 5, style = plot.style_circles, display = display.pane)
plot("absorb_l", hasAbsorption and ratio >= 2.3 ? bubblePrice : na, "Absorption L", color = absorbColor, linewidth = 10, style = plot.style_circles, display = display.pane)

// --- 3. Optional custom candle colors ---
barcolor("candles", colorCandles ? (close >= open ? bullCandleColor : bearCandleColor) : na)
